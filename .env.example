# =============================================================================
# Kriti LMS / Drona Engine — environment variable template
# Copy to `.env` in the repository root and fill in secrets locally.
# NEVER commit a real `.env` file.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM / API keys (required for storyboard generation)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional OpenAI key (CLI accepts --provider openai; full wiring may be incomplete)
# OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Compute provider / RunPod lifecycle
# RUNPOD_API_KEY is a secret. Keep it in the local environment / secret store.
# A stopped RunPod releases its GPU and can later fail to restart if the original
# physical host has no free GPU. Kriti retries that temporary capacity condition.
# -----------------------------------------------------------------------------
# KRITI_COMPUTE_PROVIDER=runpod
# KRITI_RUNPOD_POD_ID=
# RUNPOD_API_KEY=
# KRITI_RUNPOD_API_BASE_URL=https://rest.runpod.io/v1
# KRITI_RUNPOD_REQUEST_TIMEOUT_SECONDS=30
# KRITI_RUNPOD_POLL_INTERVAL_SECONDS=5
# KRITI_RUNPOD_CAPACITY_RETRY_TIMEOUT_SECONDS=180
# KRITI_RUNPOD_CAPACITY_RETRY_INTERVAL_SECONDS=15
# KRITI_WORKER_HOSTNAME=kriti-runpod

# -----------------------------------------------------------------------------
# RunPod durable network volume
# `python -m compute.cli volume create --confirm-create` creates billable storage.
# Network volumes for Pods are Secure Cloud only and must be attached at Pod creation.
# -----------------------------------------------------------------------------
# KRITI_RUNPOD_NETWORK_VOLUME_ID=
# KRITI_RUNPOD_NETWORK_VOLUME_NAME=kriti-workspace
# KRITI_RUNPOD_NETWORK_VOLUME_SIZE_GB=100
# KRITI_RUNPOD_NETWORK_VOLUME_DATA_CENTER_ID=

# -----------------------------------------------------------------------------
# Disposable RunPod GPU worker
# Prefer a RunPod template carrying image, environment variables, secret references,
# ports, and container start command. GPU type IDs are comma-separated and RunPod
# chooses by availability within the network volume's data center.
# -----------------------------------------------------------------------------
# KRITI_RUNPOD_DISPOSABLE_TEMPLATE_ID=
# KRITI_RUNPOD_DISPOSABLE_IMAGE_NAME=
# KRITI_RUNPOD_DISPOSABLE_GPU_TYPE_IDS=
# KRITI_RUNPOD_DISPOSABLE_GPU_COUNT=1
# KRITI_RUNPOD_DISPOSABLE_NAME_PREFIX=kriti-worker
# KRITI_RUNPOD_DISPOSABLE_CONTAINER_DISK_GB=50

# -----------------------------------------------------------------------------
# Windows preflight orchestrator
# -----------------------------------------------------------------------------
# KRITI_WORKER_REPO_PATH=/workspace/kriti_lms
# KRITI_GIT_REMOTE_URL=https://github.com/shashankshekhar1311/kriti_lms.git
# KRITI_PROVIDER_READY_TIMEOUT_SECONDS=600
# KRITI_TRANSPORT_READY_TIMEOUT_SECONDS=180
# KRITI_TRANSPORT_POLL_INTERVAL_SECONDS=5

# -----------------------------------------------------------------------------
# Windows control plane -> RunPod transport over Tailscale SSH
# These values are non-secret. The Windows machine must have the Tailscale CLI
# installed, logged into the same tailnet, and allowed by Tailscale SSH policy.
# -----------------------------------------------------------------------------
# KRITI_TAILSCALE_SSH_USER=root
# KRITI_TAILSCALE_COMMAND_TIMEOUT_SECONDS=60
# KRITI_TAILSCALE_HEALTH_TIMEOUT_SECONDS=15

# -----------------------------------------------------------------------------
# Tailscale bootstrap for RunPod worker
# TAILSCALE_AUTH_KEY is a secret. Prefer a reusable/tagged key in RunPod Secrets.
# The key is only needed for first enrollment or when persistent state is lost.
# -----------------------------------------------------------------------------
# TAILSCALE_AUTH_KEY=
# KRITI_TAILSCALE_AUTO_INSTALL=1
# KRITI_TAILSCALE_ENABLE_SSH=1
# KRITI_TAILSCALE_INSTALL_URL=https://tailscale.com/install.sh
# KRITI_TAILSCALE_STATE_DIR=/workspace/tailscale
# KRITI_TAILSCALE_STATE_FILE=/workspace/tailscale/tailscaled.state
# KRITI_TAILSCALE_RUNTIME_DIR=/var/run/tailscale
# KRITI_TAILSCALE_SOCKET=/var/run/tailscale/tailscaled.sock
# KRITI_TAILSCALE_PID_FILE=/var/run/tailscale/kriti-tailscaled.pid
# KRITI_TAILSCALE_LOG=/tmp/kriti-tailscaled.log
# KRITI_TAILSCALE_START_TIMEOUT_SECONDS=20
# KRITI_TAILSCALE_LEGACY_STATE_FILE=/var/lib/tailscale/tailscaled.state

# RunPod container-start wrapper settings (non-secret)
# KRITI_STARTUP_REPO_WAIT_SECONDS=60
# KRITI_RUNPOD_BASE_START_SCRIPT=/start.sh

# -----------------------------------------------------------------------------
# Runtime data paths
# With a network volume attached at /workspace these paths persist across workers.
# -----------------------------------------------------------------------------
# KRITI_SOURCE_BOOKS=/workspace/kriti_lms/Source_Books
# KRITI_OUTPUT_DIR=/workspace/data/Rendered_Output
# KRITI_TEMP_DIR=/workspace/temp

# -----------------------------------------------------------------------------
# Persistent model / library caches
# -----------------------------------------------------------------------------
# HF_HOME=/workspace/caches/huggingface
# TORCH_HOME=/workspace/caches/torch
# U2NET_HOME=/workspace/caches/rembg

# -----------------------------------------------------------------------------
# Lip-sync (local Wav2Lip / LivePortrait — no SaaS keys)
# -----------------------------------------------------------------------------
# LIP_SYNC_MODELS_DIR=/workspace/models/lipsync
# WAV2LIP_ROOT=
# WAV2LIP_REPO=https://github.com/Rudrabha/Wav2Lip.git
# LIVEPORTRAIT_ROOT=
# LIVEPORTRAIT_REPO=https://github.com/KwaiVGI/LivePortrait.git
# LIP_SYNC_ENGINE=wav2lip
# LIP_SYNC_REQUIRE_GPU=0
# LIP_SYNC_PRESENTER_MODE=0
# LIP_SYNC_GPU_TIMEOUT=900
# LIP_SYNC_MAX_FACE_EDGE=1024
# LIP_SYNC_AUTO_CLONE_LIVEPORTRAIT=0

# -----------------------------------------------------------------------------
# TTS
# -----------------------------------------------------------------------------
# EDGE_TTS_PROXY=

# -----------------------------------------------------------------------------
# Remotion / Chromium
# -----------------------------------------------------------------------------
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# CHROME_PATH=/usr/bin/chromium
# PUPPETEER_SKIP_DOWNLOAD=true
# HF_HUB_ENABLE_HF_TRANSFER=0

# -----------------------------------------------------------------------------
# CUDA
# -----------------------------------------------------------------------------
# CUDA_VISIBLE_DEVICES=0

# -----------------------------------------------------------------------------
# Legacy Windows PC -> RunPod OpenSSH/SCP downloader
# -----------------------------------------------------------------------------
# KRITI_RUNPOD_HOST=
# KRITI_RUNPOD_PORT=
# KRITI_RUNPOD_USER=root
# KRITI_RUNPOD_REMOTE_OUTPUT=/workspace/kriti_lms/Rendered_Output
# KRITI_LOCAL_OUTPUT=E:\Kriti\Rendered_Output
